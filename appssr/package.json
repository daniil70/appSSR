{
  "name": "appssr",
  "productName": "AppSSR",
  "version": "0.1.0",
  "description": "AppSSR — каталог и менеджер программ SSR (макет без БД)",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:win": "npm run build && electron-builder --win",
    "preview": "vite preview --mode web",
    "start": "electron ."
  },
  "author": "SSR",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "build": {
    "appId": "space.alabuga.appssr",
    "productName": "AppSSR",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
