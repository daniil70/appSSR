<Window x:Class="AppSSR.Wpf.Dialogs.ProgramEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:AppSSR.Wpf.Controls"
        Title="{Binding Title}" Width="720" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="22,18,22,0">
      <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Click="OnCancel" Content="✕"/>
      <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
    </DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,8,22,18">
      <Button Content="Отмена" Style="{StaticResource BtnOutline}" Margin="0,0,10,0" IsCancel="True" Click="OnCancel"/>
      <Button Content="Сохранить" Style="{StaticResource BtnPrimary}" IsDefault="True" Click="OnSave"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="22,12">
      <StackPanel>
        <Border Background="#FDECEC" CornerRadius="8" Padding="8" Margin="0,0,0,12" Visibility="{Binding Error, Converter={StaticResource NullVis}}">
          <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <ctrl:AppIcon Icon="{Binding Item.Icon}" Color="{Binding Item.Color}" Size="64"/>
          <StackPanel Margin="14,0,0,0">
            <TextBlock Text="Цвет" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ItemsControl ItemsSource="{Binding Colors}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="26" Height="26" Margin="0,0,6,0" Click="OnColor" Tag="{Binding}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border Background="{Binding Converter={StaticResource Brush}}" CornerRadius="8"/>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Название *" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
            <Border Style="{StaticResource FieldBox}"><TextBox Text="{Binding Item.Name, UpdateSourceTrigger=PropertyChanged}"/></Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Тип" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
            <Border Style="{StaticResource FieldBox}">
              <ComboBox SelectedIndex="{Binding TypeIndex}" BorderThickness="0" Background="Transparent">
                <ComboBoxItem Content="Внешняя (установка из GitLab)"/>
                <ComboBoxItem Content="Встроенная в AppSSR"/>
              </ComboBox>
            </Border>
          </StackPanel>
        </Grid>
        <TextBlock Text="Краткое описание" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,6"/>
        <Border Style="{StaticResource FieldBox}"><TextBox Text="{Binding Item.ShortDescription, UpdateSourceTrigger=PropertyChanged}"/></Border>
        <TextBlock Text="Описание" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,6"/>
        <Border Style="{StaticResource FieldBox}" Padding="10">
          <TextBox Text="{Binding Item.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
        </Border>
        <CheckBox Content="Доступна для установки" IsChecked="{Binding Item.Available}" Margin="0,12,0,0"/>
        <StackPanel Visibility="{Binding IsExternal, Converter={StaticResource Vis}}">
          <TextBlock Text="Команда установки (cmd)" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,6"/>
          <Border Style="{StaticResource FieldBox}">
            <TextBox Text="{Binding Item.InstallCommand, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="13"/>
          </Border>
          <TextBlock Text="Выполняется в папке установки AppSSR. Авторизация GitLab должна быть настроена на устройстве заранее." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Папка программы" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
              <Border Style="{StaticResource FieldBox}"><TextBox Text="{Binding Item.InstallDir, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/></Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Исполняемый файл" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
              <Border Style="{StaticResource FieldBox}"><TextBox Text="{Binding Item.ExePath, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/></Border>
            </StackPanel>
          </Grid>
          <TextBlock Text="Адрес репозитория" FontWeight="SemiBold" FontSize="13" Margin="0,12,0,6"/>
          <Border Style="{StaticResource FieldBox}"><TextBox Text="{Binding Item.RepoUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/></Border>
        </StackPanel>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Версия" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
            <Border Style="{StaticResource FieldBox}"><TextBox Text="{Binding Item.Version, UpdateSourceTrigger=PropertyChanged}"/></Border>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Разработчик" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
            <Border Style="{StaticResource FieldBox}"><TextBox Text="{Binding Item.Developer, UpdateSourceTrigger=PropertyChanged}"/></Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
